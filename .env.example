# ============================================================
# QueryMind — Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# ------ Database ------
# Full PostgreSQL connection string for the application
DATABASE_URL=postgresql://querymind_user:querymind_pass@localhost:5432/querymind_db

# Read-only user connection (used for executing user queries safely)
DATABASE_READONLY_URL=postgresql://querymind_readonly:readonly_pass@localhost:5432/querymind_db

# Postgres admin connection (used only for setup/migrations)
DATABASE_ADMIN_URL=postgresql://postgres:postgres@localhost:5432/postgres

# ------ LLM Provider ------
# Options: ollama, openai, gemini  (only ollama implemented in Phase 1)
LLM_PROVIDER=ollama

# ------ Ollama ------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:14b
OLLAMA_TIMEOUT=120

# ------ OpenAI (future) ------
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o

# ------ Gemini (future) ------
# GEMINI_API_KEY=...
# GEMINI_MODEL=gemini-1.5-pro

# ------ SQL Execution ------
# Maximum number of self-correction retries on SQL failure
MAX_SQL_RETRIES=3

# SQL query timeout in seconds
SQL_QUERY_TIMEOUT=30

# ------ API ------
# FastAPI host and port
API_HOST=0.0.0.0
API_PORT=8000

# Set to "development" to expose detailed error info; "production" to hide it
APP_ENV=development

# CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ------ Logging ------
LOG_LEVEL=INFO
